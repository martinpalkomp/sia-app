rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         request.auth.token.email == 'martinpalko.mp@gmail.com');
    }

    function isPremium(userId) {
      let user = get(/databases/$(database)/documents/users/$(userId)).data;
      return user.keys().hasAll(['subscription']) && 
             user.subscription.tier == 'premium' && 
             request.time < user.subscription.validUntil;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFeedback(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() < 100 &&
             data.category in ['Bug Report', 'Feature Request', 'Data Issue', 'UI/UX', 'Other'] &&
             data.message is string && data.message.size() > 0 && data.message.size() < 5000 &&
             data.status in ['open', 'resolved'] &&
             data.version is string;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidDailyBrief(data) {
      return hasOnlyAllowedFields(['date', 'content', 'createdAt']) &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             data.content is string && data.content.size() < 5000 &&
             data.createdAt is timestamp;
    }

    function isValidAICorrection(data) {
      return hasOnlyAllowedFields(['field', 'suggestedValue', 'actualValue', 'date', 'createdAt']) &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             data.field is string && data.field.size() < 100 &&
             data.createdAt is timestamp;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Only allow creation of basic user profile, role must be 'user' or omitted (defaulting to user)
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'user');
      // Prevent users from changing their own role and subscription status. Allow tier toggles for demoing.
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'subscription'])
      ) &&
      (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() < 100)) &&
      (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 500));
      // Admin can do anything
      allow write: if isAdmin();
    }

    // User subcollections (logs, data)
    match /users/{userId}/daily_logs/{logId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/premium_exports/{docId} {
      allow read, write: if isOwner(userId) && isPremium(userId);
    }

    match /users/{userId}/daily_briefs/{briefId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidDailyBrief(request.resource.data);
    }

    match /users/{userId}/ai_corrections/{correctionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidAICorrection(request.resource.data);
    }

    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if (isOwner(userId) || isAdmin()) && collection != 'premium_exports' && collection != 'daily_briefs' && collection != 'ai_corrections' && collection != 'daily_logs';
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && isValidFeedback(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Insights collection
    match /users/{userId}/insights/{insightId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}

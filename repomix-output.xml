                                    </p>
                                    <p className="text-[8px] text-zinc-500 uppercase tracking-widest leading-tight">
                                      {historyCount === 0 ? "Log your first night to enable pattern prefill" : "Log more nights to enable pattern prefill"}
                                    </p>
                                  </div>
                                </button>
                              );

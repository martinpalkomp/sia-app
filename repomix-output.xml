    // Row 2 — rule row: grey background #E8E8E8, italic grey text showing format hints
    const hints = [
      'YYYY-MM-DD', 'HH:mm', 'HH:mm', 'SLEEP/AWAKE-IN', '0-10', '0-10', '0-10', 'Text',
      'yes/no', 'number', 'HH:mm',
      'yes/no', 'number', 'HH:mm',
      'yes/no', 'Text', 'HH:mm',
      'yes/no', 'Text', 'HH:mm',

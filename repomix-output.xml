                >
                  Legal & Privacy Information
                </button>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    );
  }

  return (
    <UserProvider
      logs={logs}
      user={user}
      userProfile={userProfile}
      personalizationProfile={personalizationProfile}
      isProfileLoading={isProfileLoading}
      tier={derivedTier}
      maturity={maturity}

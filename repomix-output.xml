                      onDateChange={changeDate}
                      onOpenPersonalization={() => setShowPersonalizationWizard(true)}
                      onOpenSleepGuide={() => setShowSleepGuide(true)}
                      refreshAllData={refreshAllData}
                      isRefreshing={isRefreshing}
                    />
                  </Suspense>
                </motion.div>
              </AnimatePresence>
            </motion.div>
          ) : view === 'corrections' ? (

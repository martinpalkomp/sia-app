                            if (confidence < 0.8 && !(activeSuggestion as any).median) {
                              return (
                                <button
                                  onClick={() => setShowPrefillConfirm(true)}
                                  className="w-full h-full flex flex-col items-center justify-center gap-3 group p-6"

{
  "entities": {
    "SleepLog": {
      "title": "Sleep Log",
      "description": "A structured sleep log entry for a specific date.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "timeline": { "type": "array", "items": { "type": "string" } },
        "sleepQuality": { "type": "integer" },
        "restedness": { "type": "integer" },
        "energyLevel": { "type": "integer" },
        "remarks": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["date", "timeline"]
    },
    "UnstructuredData": {
      "title": "Unstructured Data",
      "description": "Raw text or malformed data uploaded by the user.",
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "content": { "type": "string" },
        "uploadDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["raw_text"] },
        "source": { "type": "string" }
      },
      "required": ["fileName", "content", "uploadDate", "status"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback or bug reports.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "category": { "type": "string", "enum": ["Bug Report", "Feature Request", "Data Issue", "UI/UX", "Other"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "version": { "type": "string" },
        "attachedLogs": { "type": "object" }
      },
      "required": ["userId", "userName", "category", "message", "timestamp", "status", "version"]
    }
  },
  "firestore": {
    "/users/{userId}/sleep_logs/{date}": {
      "schema": "SleepLog",
      "description": "Collection of structured sleep logs."
    },
    "/users/{userId}/unstructured_data/{docId}": {
      "schema": "UnstructuredData",
      "description": "Collection of raw, unstructured data uploads."
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Global collection of user feedback."
    }
  }
}

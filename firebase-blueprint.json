{
  "entities": {
    "SleepLog": {
      "title": "Sleep Log",
      "description": "A structured sleep log entry for a specific date.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "isIgnored": { "type": "boolean" },
        "sleep_quality": { "type": "integer" },
        "morning_alertness": { "type": "integer" },
        "daytime_energy": { "type": "integer" },
        "daily_remarks": { "type": "string" },
        "sleepEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["sleep", "awake-in", "awake-out"] },
              "start": { "type": "string", "pattern": "HH:mm" },
              "end": { "type": "string", "pattern": "HH:mm" }
            },
            "required": ["id", "type", "start", "end"]
          }
        },
        "factors": {
          "type": "object",
          "properties": {
            "caffeine": {
              "type": "object",
              "properties": {
                "consumed": { "type": "boolean" },
                "amount": { "type": "number" },
                "lastIntake": { "type": "string" }
              }
            },
            "alcohol": {
              "type": "object",
              "properties": {
                "consumed": { "type": "boolean" },
                "drinks": { "type": "number" },
                "lastIntake": { "type": "string" }
              }
            },
            "medication": {
              "type": "object",
              "properties": {
                "taken": { "type": "boolean" },
                "type": { "type": "string" },
                "time": { "type": "string" }
              }
            },
            "exercise": {
              "type": "object",
              "properties": {
                "completed": { "type": "boolean" },
                "type": { "type": "string" },
                "time": { "type": "string" }
              }
            },
            "screensInBed": { "type": "boolean" },
            "stressLevel": { "type": "integer" },
            "lastMealTime": { "type": "string", "pattern": "HH:mm", "description": "Time of last meal before sleep" },
            "naturalWake": { "type": "boolean", "description": "True if woke without alarm" },
            "moodScore": { "type": "integer", "description": "1-5 subjective mood on waking" },
            "sleepGadgets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "light_therapy", "breathing_trainer", "pre_sleep_heating", "aromatherapy",
                      "meditation_app", "cooling_pad", "white_noise", "sleep_mask", "earplugs",
                      "weighted_blanket", "smart_ring", "smartwatch_tracking", "fitness_band", "phone_sleep_app"
                    ]
                  },
                  "durationMinutes": { "type": "number" },
                  "timeOfUse": {
                    "type": "string",
                    "enum": [
                      "morning", "afternoon", "evening", "before_bed_15", "before_bed_30", "before_bed_60", "all_night"
                    ]
                  }
                }
              }
            }
          }
        },
        "summaryMetrics": {
          "type": "object",
          "properties": {
            "sleep_quality": { "type": "integer" },
            "morning_alertness": { "type": "integer" },
            "daytime_energy": { "type": "integer" },
            "importedDuration": { "type": "number" },
            "importedInBed": { "type": "number" },
            "sleep_efficiency": { "type": "number" }
          }
        },
        "source": { "type": "string", "enum": ["manual", "import"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "isIgnored", "sleep_quality", "morning_alertness", "daytime_energy"]
    },
    "PersonalizationProfile": {
      "title": "Personalization Profile",
      "description": "User's sleep goals, demographics, and clinical data.",
      "type": "object",
      "properties": {
        "demographics": {
          "type": "object",
          "properties": {
            "dateOfBirth": { "type": "string", "format": "date" },
            "country": { "type": "string" },
            "sex": { "type": "string", "enum": ["Male", "Female", "Other"] },
            "workSchedule": { "type": "string", "enum": ["Regular Hours", "Shift Work"] },
            "environmentType": { "type": "string", "enum": ["Noisy/Urban", "Quiet/Controlled"] }
          }
        },
        "goals": { "type": "array", "items": { "type": "string" } },
        "psqi": { "type": "object" },
        "clinical": { "type": "object" },
        "allowsAnonymizedSharing": { "type": "boolean" },
        "connectedDevices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["light_therapy", "thermal", "acoustic", "wearable", "other"] },
              "brand": { "type": "string", "description": "e.g. Luminette, Eight Sleep, Oura" },
              "model": { "type": "string" },
              "inUse": { "type": "boolean" }
            },
            "required": ["type", "brand", "inUse"]
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AICorrection": {
      "title": "AI Correction",
      "description": "Corrections made by the user to AI-suggested sleep logs.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "originalTimeline": { "type": "array" },
        "suggestedTimeline": { "type": "array" },
        "reason": { "type": "string" },
        "applied": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Basic user account information.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Insight": {
      "title": "Insight",
      "description": "An AI-generated insight about the user's sleep patterns.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Pattern", "Risk", "Recommendation"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "linkedDates": { "type": "array", "items": { "type": "string", "format": "date" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "confidence", "summary", "linkedDates", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document."
    },
    "/users/{userId}/personalization/profile": {
      "schema": "PersonalizationProfile",
      "description": "User's personalization settings."
    },
    "/users/{userId}/sleep_logs/{date}": {
      "schema": "SleepLog",
      "description": "Daily sleep logs and metrics."
    },
    "/users/{userId}/ai_corrections/{correctionId}": {
      "schema": "AICorrection",
      "description": "AI-suggested corrections and user feedback."
    },
    "/users/{userId}/daily_metrics/{date}": {
      "description": "Computed daily metrics synced from sleep_logs. date, sleep_quality, morning_alertness, daytime_energy, daily_remarks, source, updatedAt."
    },
    "/users/{userId}/unstructured_data/{docId}": {
      "description": "Raw uploaded files and pasted text indexed for AI analysis. fileName, content, uploadDate, status, summary, extractedInsights, rawDataType."
    },
    "/users/{userId}/chats/{messageId}": {
      "description": "AI chat history messages. Each document has role (user/assistant), content (string), and createdAt (timestamp)."
    },
    "/users/{userId}/insights/{insightId}": {
      "schema": "Insight",
      "description": "AI-generated insights and recommendations."
    },
    "/_sia_system/connection_test": {
      "description": "System-level connection test document."
    }
  }
}

{
  "entities": {
    "SleepLog": {
      "title": "Sleep Log",
      "description": "A structured sleep log entry for a specific date.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "sleepEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["sleep", "wake", "restless"] },
              "startTime": { "type": "string", "pattern": "HH:mm" },
              "endTime": { "type": "string", "pattern": "HH:mm" }
            },
            "required": ["type", "startTime", "endTime"]
          }
        },
        "sleep_quality": { "type": "integer" },
        "morning_alertness": { "type": "integer" },
        "daytime_energy": { "type": "integer" },
        "remarks": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["date", "sleepEvents"]
    },
    "UnstructuredData": {
      "title": "Unstructured Data",
      "description": "Raw text or malformed data uploaded by the user.",
      "type": "object",
      "properties": {
        "fileName": { "type": "string" },
        "content": { "type": "string" },
        "uploadDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["raw_text"] },
        "source": { "type": "string" }
      },
      "required": ["fileName", "content", "uploadDate", "status"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback or bug reports.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "category": { "type": "string", "enum": ["Bug Report", "Feature Request", "Data Issue", "UI/UX", "Other"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "version": { "type": "string" },
        "attachedLogs": { "type": "object" }
      },
      "required": ["userId", "userName", "category", "message", "timestamp", "status", "version"]
    },
    "DailyMetrics": {
      "title": "Daily Metrics",
      "description": "Clinical sleep metrics for a specific date.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "sleep_quality": { "type": "integer" },
        "morning_alertness": { "type": "integer" },
        "daytime_energy": { "type": "integer" },
        "daily_remarks": { "type": "string" },
        "source": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "sleep_quality", "morning_alertness", "daytime_energy"]
    }
  },
  "firestore": {
    "/users/{userId}/sleep_logs/{date}": {
      "schema": "SleepLog",
      "description": "Event-based sleep ledger. Each document represents one 24-hour cycle starting at 20:00."
    },
    "/users/{userId}/daily_metrics/{date}": {
      "schema": "DailyMetrics",
      "description": "Clinical sleep metrics for a specific date."
    },
    "/users/{userId}/unstructured_data/{docId}": {
      "schema": "UnstructuredData",
      "description": "Collection of raw, unstructured data uploads."
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "Global collection of user feedback."
    }
  }
}
